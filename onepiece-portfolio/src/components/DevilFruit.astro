---
---

<section class="devils-fruit-section section" id="devils-fruit" aria-labelledby="fruits-title">
  <div class="container">
    <div class="fruit-intro" data-reveal>
      <div>
        <p class="note-label">Devil Fruits</p>
        <h2 id="fruits-title">Skills Graded by Power Type</h2>
      </div>
      <p style="color: var(--text-dim); max-width: 400px;">
        In the world of One Piece, Devil Fruits grant extraordinary abilities.
        My skills are categorized by the type of power they provide.
      </p>
    </div>

    <!-- Paramecia -->
    <div class="fruit-type-group" data-reveal>
      <div class="fruit-type-header">
        <span class="fruit-type-badge paramecia">Paramecia</span>
        <span class="fruit-type-desc">Superhuman abilities that alter the body or environment</span>
      </div>
      <div class="fruit-grid" data-stagger>
        <div class="fruit-card">
          <div class="fruit-icon build">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <rect x="4" y="4" width="24" height="24" rx="3" stroke="var(--red)"/>
              <line x1="10" y1="12" x2="22" y2="12" stroke="var(--red)"/>
              <line x1="10" y1="17" x2="18" y2="17" stroke="var(--red)"/>
              <line x1="10" y1="22" x2="14" y2="22" stroke="var(--red)"/>
            </svg>
          </div>
          <div class="fruit-info">
            <h4>Gomu Gomu no Build</h4>
            <p>Java, Spring Boot, REST APIs, React, Next.js, TypeScript</p>
          </div>
        </div>
        <div class="fruit-card">
          <div class="fruit-icon store">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <ellipse cx="16" cy="16" rx="12" ry="14" stroke="var(--sky)"/>
              <line x1="16" y1="2" x2="16" y2="30" stroke="var(--sky)"/>
              <ellipse cx="16" cy="16" rx="6" ry="14" stroke="var(--sky)"/>
            </svg>
          </div>
          <div class="fruit-info">
            <h4>Bara Bara no Store</h4>
            <p>PostgreSQL, Oracle SQL, MySQL, Redis, Schema Design, SQL Procedures</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Zoan -->
    <div class="fruit-type-group" data-reveal>
      <div class="fruit-type-header">
        <span class="fruit-type-badge zoan">Zoan</span>
        <span class="fruit-type-desc">Transformation into animals — adaptability and instinct</span>
      </div>
      <div class="fruit-grid" data-stagger>
        <div class="fruit-card">
          <div class="fruit-icon verify">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="16" cy="16" r="12" stroke="var(--gold)"/>
              <path d="M10 16l4 4 8-8" stroke="var(--gold)"/>
            </svg>
          </div>
          <div class="fruit-info">
            <h4>Hito Hito no Verify</h4>
            <p>Selenium WebDriver, TestNG, Postman, Manual Testing, API Testing, Regression</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Logia -->
    <div class="fruit-type-group" data-reveal>
      <div class="fruit-type-header">
        <span class="fruit-type-badge logia">Logia</span>
        <span class="fruit-type-desc">Control over natural elements — power at scale</span>
      </div>
      <div class="fruit-grid" data-stagger>
        <div class="fruit-card">
          <div class="fruit-icon ship">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 24l12-16 12 16" stroke="var(--ocean)"/>
              <line x1="16" y1="8" x2="16" y2="24" stroke="var(--ocean)"/>
              <line x1="8" y1="18" x2="24" y2="18" stroke="var(--ocean)"/>
            </svg>
          </div>
          <div class="fruit-info">
            <h4>Mera Mera no Ship</h4>
            <p>Git, GitHub, Docker, Render, Vercel, Neon, Upstash</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
