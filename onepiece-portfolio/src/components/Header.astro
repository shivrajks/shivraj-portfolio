---
import { NAV, LINKS } from "../data/content";
---

<a class="skip-link" href="#main">Skip to main content</a>

<header class="site-header" data-header>
  <div class="container nav-shell">
    <a class="brand" href="#home" aria-label="Shivraj Sonwane — Home">
      <svg class="brand-hat" viewBox="0 0 40 40" width="32" height="32" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="#D70000"/>
        <ellipse cx="20" cy="22" rx="14" ry="6" fill="#FFCD00"/>
        <rect x="17" y="8" width="6" height="16" rx="3" fill="#AF6528"/>
      </svg>
      <span class="brand-text">
        <span class="brand-name">Shivraj Sonwane</span>
        <span class="brand-role">Software Engineer</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="nav-links">
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-menu" data-mobile-menu aria-label="Mobile navigation" hidden>
    {NAV.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(10, 22, 40, 0.7);
    border-bottom: 1px solid var(--line);
    transition: background 0.3s, box-shadow 0.3s;
  }

  .site-header.is-scrolled {
    background: rgba(10, 22, 40, 0.95);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--white);
    transition: color 0.2s;
  }

  .brand:hover {
    color: var(--gold);
  }

  .brand-hat {
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.1;
  }

  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold);
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 720px) {
    .desktop-nav {
      display: flex;
      gap: 1.5rem;
    }

    .desktop-nav a {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-dim);
      transition: color 0.2s;
    }

    .desktop-nav a:hover {
      color: var(--gold);
    }
  }

  .nav-links {
    display: none;
  }

  @media (min-width: 920px) {
    .nav-links {
      display: flex;
      gap: 1rem;
    }

    .nav-links a {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-dim);
      padding: 0.35rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      transition: border-color 0.2s, color 0.2s;
    }

    .nav-links a:hover {
      border-color: var(--sky);
      color: var(--sky);
    }
  }

  /* Mobile menu toggle */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 1px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: rotate(45deg) translate(2.5px, 2.5px);
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: rotate(-45deg) translate(2.5px, -2.5px);
  }

  @media (min-width: 720px) {
    .menu-toggle {
      display: none;
    }
  }

  /* Mobile nav */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 1rem var(--gap) 1.5rem;
    gap: 0.25rem;
    background: rgba(10, 22, 40, 0.98);
    border-top: 1px solid var(--line);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav a {
    padding: 0.6rem 0;
    font-weight: 700;
    color: var(--text-dim);
    border-bottom: 1px solid var(--line);
    transition: color 0.2s;
  }

  .mobile-nav a:hover {
    color: var(--gold);
  }

  @media (min-width: 720px) {
    .mobile-nav {
      display: none !important;
    }
  }
</style>
