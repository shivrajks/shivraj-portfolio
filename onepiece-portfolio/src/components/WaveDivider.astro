---
interface Props {
  color?: string;
  flip?: boolean;
}

const { color = "var(--deep-sea)", flip = false } = Astro.props;
---

<div class:list={["wave-divider", { flip }]}>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path
      d="M0,20 C240,60 480,0 720,30 C960,60 1200,10 1440,40 L1440,60 L0,60 Z"
      fill={color}
      opacity="0.5"
    />
    <path
      d="M0,30 C360,0 720,50 1080,20 C1260,10 1380,30 1440,25 L1440,60 L0,60 Z"
      fill={color}
      opacity="0.8"
    />
    <path
      d="M0,45 C180,30 420,55 660,40 C900,25 1140,50 1440,35 L1440,60 L0,60 Z"
      fill={color}
    />
  </svg>
</div>

<style>
  .wave-divider {
    width: 100%;
    overflow: hidden;
    line-height: 0;
    margin-top: -1px;
  }

  .wave-divider svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  .wave-divider.flip {
    transform: rotate(180deg);
    margin-bottom: -1px;
    margin-top: 0;
  }
</style>
